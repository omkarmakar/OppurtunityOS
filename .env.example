# ── Application ──────────────────────────────────────────────────────
# Environment: development | testing | production
OOS_ENVIRONMENT=development
OOS_DEBUG=true
OOS_SECRET_KEY=change-me-in-production

# ── Database ─────────────────────────────────────────────────────────
# SQLite (default):   sqlite:///./data/opportunity.db
# PostgreSQL example: postgresql://user:pass@localhost:5432/opportunity
OOS_DATABASE__URL=sqlite:///./data/opportunity.db
OOS_DATABASE__ECHO=false
OOS_DATABASE__POOL_SIZE=5
OOS_DATABASE__MAX_OVERFLOW=10

# ── Logging ──────────────────────────────────────────────────────────
OOS_LOGGING__LEVEL=DEBUG
OOS_LOGGING__ROTATION=1 day
OOS_LOGGING__RETENTION=30 days
OOS_LOGGING__DIRECTORY=logs

# ── Server ───────────────────────────────────────────────────────────
OOS_SERVER__HOST=127.0.0.1
OOS_SERVER__PORT=8000
OOS_SERVER__ALLOWED_ORIGINS=["*"]

# ── Paths ────────────────────────────────────────────────────────────
OOS_PATHS__DATA_DIR=data
OOS_PATHS__CONFIG_DIR=config
OOS_PATHS__LOG_DIR=logs
OOS_PATHS__ASSET_DIR=assets

# ── Tavily Search ─────────────────────────────────────────────────────
# Free tier: 1,000 credits/month — https://tavily.com
# Obtain your key at: https://app.tavily.com/home
OOS_TAVILY__API_KEY=tvly-your-api-key-here
# OOS_TAVILY__BASE_URL=https://api.tavily.com/search  # default, override if needed

# ── AI Provider ───────────────────────────────────────────────────────
# Default AI provider: dummyai, gemini, groq, openai, openrouter, ollama
OOS_AI__DEFAULT_PROVIDER=ollama
OOS_AI__DEFAULT_MODEL=llama3.1:8b
# Ollama base URL (default: http://localhost:11434)
# OOS_AI__OLLAMA__BASE_URL=http://your-ollama-server:11434
# Gemini API key (https://makersuite.google.com/app/apikey)
# OOS_AI__GEMINI_API_KEY=your-gemini-api-key-here
# Groq API key (https://console.groq.com/keys)
# OOS_AI__GROQ_API_KEY=your-groq-api-key-here
# OpenAI API key (https://platform.openai.com/api-keys)
# OOS_AI__OPENAI_API_KEY=your-openai-api-key-here
# OpenRouter API key (https://openrouter.ai/keys)
# OOS_AI__OPENROUTER_API_KEY=your-openrouter-api-key-here

# ── Brave Search (legacy — free tier discontinued Feb 2026) ──────────
# OOS_BRAVE_SEARCH__API_KEY=your-brave-api-key-here
# OOS_BRAVE_SEARCH__BASE_URL=https://api.search.brave.com/res/v1/web/search

# ── Background Scheduler ──────────────────────────────────────────────
# OOS_BACKGROUND_SCHEDULER__PIPELINE_SEARCH_PROVIDER=tavily  # set after adding Tavily key
# OOS_BACKGROUND_SCHEDULER__TIMEZONE=Asia/Kolkata
# OOS_BACKGROUND_SCHEDULER__PIPELINE_WINDOW_START_HOUR=6
# OOS_BACKGROUND_SCHEDULER__PIPELINE_WINDOW_END_HOUR=12
