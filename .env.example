# ── Application ──────────────────────────────────────────────────────
# Environment: development | testing | production
OOS_ENVIRONMENT=development
OOS_DEBUG=true
OOS_SECRET_KEY=change-me-in-production
# OOS_APP_NAME=OpportunityOS
# OOS_VERSION=0.1.0

# ── Database ─────────────────────────────────────────────────────────
# SQLite (default):   sqlite:///./data/opportunity.db
# PostgreSQL example: postgresql://user:pass@localhost:5432/opportunity
OOS_DATABASE__URL=sqlite:///./data/opportunity.db
OOS_DATABASE__ECHO=false
OOS_DATABASE__POOL_SIZE=5
OOS_DATABASE__MAX_OVERFLOW=10

# ── Logging ──────────────────────────────────────────────────────────
OOS_LOGGING__LEVEL=DEBUG
OOS_LOGGING__ROTATION=1 day
OOS_LOGGING__RETENTION=30 days
OOS_LOGGING__DIRECTORY=logs

# ── Server ───────────────────────────────────────────────────────────
OOS_SERVER__HOST=127.0.0.1
OOS_SERVER__PORT=8000
OOS_SERVER__ALLOWED_ORIGINS=["*"]

# ── Paths ────────────────────────────────────────────────────────────
OOS_PATHS__DATA_DIR=data
OOS_PATHS__CONFIG_DIR=config
OOS_PATHS__LOG_DIR=logs
OOS_PATHS__ASSET_DIR=assets

# ── Tavily Search ─────────────────────────────────────────────────────
# Free tier: 1,000 credits/month — https://tavily.com
# Obtain your key at: https://app.tavily.com/home
OOS_TAVILY__API_KEY=tvly-your-api-key-here
# OOS_TAVILY__BASE_URL=https://api.tavily.com/search  # default, override if needed

# ── AI Provider ───────────────────────────────────────────────────────
# Default AI provider: dummyai, gemini, groq, openai, openrouter, ollama
OOS_AI__DEFAULT_PROVIDER=ollama
OOS_AI__DEFAULT_MODEL=llama3.1:8b
# Ollama base URL (default: http://localhost:11434)
# OOS_AI__OLLAMA_BASE_URL=http://your-ollama-server:11434
# Gemini API key (https://makersuite.google.com/app/apikey)
# OOS_AI__GEMINI_API_KEY=your-gemini-api-key-here
# Groq API key (https://console.groq.com/keys)
# OOS_AI__GROQ_API_KEY=your-groq-api-key-here
# OpenAI API key (https://platform.openai.com/api-keys)
# OOS_AI__OPENAI_API_KEY=your-openai-api-key-here
# OpenRouter API key (https://openrouter.ai/keys)
# OOS_AI__OPENROUTER_API_KEY=your-openrouter-api-key-here
# Fallback providers tried after default_provider fails (comma-separated)
# OOS_AI__FALLBACK_PROVIDERS=groq,gemini
# AI response cache TTL in seconds (default: 300)
# OOS_AI__CACHE_TTL=300

# ── Background Scheduler ──────────────────────────────────────────────
# Master switch (default: true)
# OOS_BACKGROUND_SCHEDULER__ENABLED=true
# Loop polling interval in seconds (default: 30)
# OOS_BACKGROUND_SCHEDULER__POLLING_INTERVAL_SECONDS=30
# Default user UUID for scheduled tasks
# OOS_BACKGROUND_SCHEDULER__DEFAULT_USER_ID=00000000-0000-0000-0000-000000000000

# Pipeline task
# OOS_BACKGROUND_SCHEDULER__PIPELINE_ENABLED=false
# OOS_BACKGROUND_SCHEDULER__PIPELINE_SEARCH_PROVIDER=tavily  # set after adding Tavily key
# OOS_BACKGROUND_SCHEDULER__PIPELINE_MAX_QUERIES=5
# OOS_BACKGROUND_SCHEDULER__PIPELINE_MAX_RESULTS=10
# OOS_BACKGROUND_SCHEDULER__PIPELINE_RETRY_COUNT=3
# OOS_BACKGROUND_SCHEDULER__PIPELINE_RETRY_DELAY_BASE=30
# OOS_BACKGROUND_SCHEDULER__TIMEZONE=Asia/Kolkata
# OOS_BACKGROUND_SCHEDULER__PIPELINE_WINDOW_START_HOUR=6
# OOS_BACKGROUND_SCHEDULER__PIPELINE_WINDOW_END_HOUR=12

# Digest task
# OOS_BACKGROUND_SCHEDULER__DIGEST_ENABLED=false
# OOS_BACKGROUND_SCHEDULER__DIGEST_INTERVAL_SECONDS=86400
# OOS_BACKGROUND_SCHEDULER__DIGEST_RETRY_COUNT=2
# OOS_BACKGROUND_SCHEDULER__DIGEST_RETRY_DELAY_BASE=60

# ── Notifications ─────────────────────────────────────────────────────
# Desktop notification delivery (default: true)
# OOS_NOTIFICATIONS__DESKTOP_ENABLED=true
# Email notification delivery (default: false)
# OOS_NOTIFICATIONS__EMAIL_ENABLED=false
# Daily digest toggle (default: false)
# OOS_NOTIFICATIONS__DIGEST_ENABLED=false
# Scheduler polling interval in seconds (default: 60)
# OOS_NOTIFICATIONS__POLLING_INTERVAL_SECONDS=60

# ── Notifications / SMTP ───────────────────────────────────────────
# OOS_NOTIFICATIONS__EMAIL__SMTP_HOST=localhost
# OOS_NOTIFICATIONS__EMAIL__SMTP_PORT=587
# OOS_NOTIFICATIONS__EMAIL__SMTP_USERNAME=
# OOS_NOTIFICATIONS__EMAIL__SMTP_PASSWORD=
# OOS_NOTIFICATIONS__EMAIL__SMTP_USE_TLS=true
# OOS_NOTIFICATIONS__EMAIL__FROM_ADDRESS=noreply@opportunityos.local
# OOS_NOTIFICATIONS__EMAIL__FROM_NAME=OpportunityOS

# ── Notifications / Digest Content ──────────────────────────────────
# OOS_NOTIFICATIONS__DIGEST__SCHEDULE_HOUR=8
# OOS_NOTIFICATIONS__DIGEST__SCHEDULE_MINUTE=0
# OOS_NOTIFICATIONS__DIGEST__MAX_OPPORTUNITIES=20
# OOS_NOTIFICATIONS__DIGEST__INCLUDE_UNREAD_ONLY=true

# ── Vector Memory (ChromaDB) ──────────────────────────────────────────
# OOS_MEMORY__ENABLED=true
# OOS_MEMORY__PERSIST_DIRECTORY=data/memory
# OOS_MEMORY__COLLECTION_NAME=opportunityos_memory
# OOS_MEMORY__TOP_K=10

# ── Plugins ───────────────────────────────────────────────────────────
# Comma-separated list of enabled plugin module paths
# OOS_PLUGINS__ENABLED_PLUGINS=
# Plugin discovery directory
# OOS_PLUGINS__PLUGIN_DIR=plugins
